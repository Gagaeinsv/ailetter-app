{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://ailetter.pro/$1",
      "permanent": true,
      "has": [{ "type": "host", "value": "www.ailetter.pro" }]
    },
    {
      "source": "/(.*)",
      "destination": "https://ailetter.pro/$1",
      "permanent": true,
      "has": [{ "type": "host", "value": "myailetter.vercel.app" }]
    }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
