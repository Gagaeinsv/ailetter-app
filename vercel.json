{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/((?!api/|assets/).*)", "destination": "/" }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://ailetter.pro/",
      "permanent": true,
      "has": [{ "type": "host", "value": "www.ailetter.pro" }]
    },
    {
      "source": "/(.*)",
      "destination": "https://ailetter.pro/$1",
      "permanent": true,
      "has": [{ "type": "host", "value": "www.ailetter.pro" }]
    },
    {
      "source": "/",
      "destination": "https://ailetter.pro/",
      "permanent": true,
      "has": [{ "type": "host", "value": "myailetter.vercel.app" }]
    },
    {
      "source": "/(.*)",
      "destination": "https://ailetter.pro/$1",
      "permanent": true,
      "has": [{ "type": "host", "value": "myailetter.vercel.app" }]
    }
  ]
}
